# Pinned dependency versions for the plugin CI pipeline.
# Source this file from CI jobs and local build scripts so the versions live
# in exactly one place. Bump values together with docs/UPGRADING_LIBOBS.md.

# Base container image (Dockerfile FROM) and its digest. Refresh deliberately.
UBUNTU_VERSION=24.04
UBUNTU_IMAGE_DIGEST=sha256:REPLACE_WITH_PINNED_DIGEST

# libobs / OBS Studio source the plugin is compiled and tested against.
OBS_VERSION=31.1.2
OBS_COMMIT=

# Distribution package used inside the Docker builder (exact version pin).
# Check with: apt-cache madison libobs-dev
LIBOBS_PACKAGE_VERSION=31.1.2-0ubuntu1

# Official OBS AppImage used as the AppImage packaging base.
OBS_APPIMAGE_URL=https://github.com/obsproject/obs-studio/releases/download/31.1.2/OBS-Studio-31.1.2-x86_64.AppImage
OBS_APPIMAGE_SHA256=REPLACE_WITH_REAL_DIGEST

# Packaging tooling.
APPIMAGETOOL_URL=https://github.com/AppImage/appimagetool/releases/download/1.10.3/appimagetool-x86_64.AppImage
APPIMAGETOOL_SHA256=REPLACE_WITH_REAL_DIGEST

# Build tooling expected inside the builder image.
CMAKE_MIN_VERSION=3.22
NINJA_VERSION=1.11.1

# Plugin release version; CI overrides this from the git tag (vX.Y.Z).
PLUGIN_VERSION=0.1.0

# Minimum obs-studio version advertised in the Debian dependency.
OBS_MIN_PACKAGE_VERSION=31.0.0
